# wtlinear - Create a worktree from a Linear ticket (nrwl org only)
# Usage: wtlinear <ticket-id> [--base <branch>] [--tmux <attach|detach|none>]

if [[ $# -lt 1 ]]; then
  echo "Usage: wtlinear <ticket-id> [--base <branch>] [--tmux <mode>]"
  echo "Examples:"
  echo "  wtlinear ENG-1234                  # create worktree + attach tmux"
  echo "  wtlinear ENG-1234 --base develop   # create worktree from develop branch"
  echo "  wtlinear ENG-1234 --tmux detach    # create worktree + detached tmux session"
  echo "  wtlinear ENG-1234 --tmux none      # create worktree, no tmux"
  return 1
fi

local ticket_id=""
local tmux_mode="attach"
local base_branch="main"

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base)
      shift
      if [[ $# -eq 0 ]]; then
        echo "Error: --base requires a branch name"
        return 1
      fi
      base_branch="$1"
      shift
      ;;
    --tmux)
      shift
      if [[ $# -eq 0 ]]; then
        echo "Error: --tmux requires a value (attach|detach|none)"
        return 1
      fi
      tmux_mode="$1"
      shift
      ;;
    *)
      if [[ -z "$ticket_id" ]]; then
        ticket_id="$1"
      else
        echo "Error: Too many arguments"
        return 1
      fi
      shift
      ;;
  esac
done

if [[ -z "$ticket_id" ]]; then
  echo "Error: ticket-id is required"
  return 1
fi

# Resolve main git root (linked worktree aware)
local git_dir git_common_dir git_root
git_dir=$(git rev-parse --git-dir 2>/dev/null) || {
  echo "Error: Not in a git repository"
  return 1
}
git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null)

local abs_git_dir abs_common_dir
abs_git_dir=$(cd "$git_dir" 2>/dev/null && pwd)
abs_common_dir=$(cd "$git_common_dir" 2>/dev/null && pwd)

if [[ "$abs_git_dir" != "$abs_common_dir" ]]; then
  git_root=$(dirname "$abs_common_dir")
else
  git_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "Error: Cannot determine git root"
    return 1
  }
fi

local org_name
org_name=$(basename "$(dirname "$git_root")")

if [[ "$org_name" != "nrwl" ]]; then
  echo "Error: wtlinear is only available for nrwl repos (current org: ${org_name})"
  return 1
fi

# Dependency checks
for cmd in opencode jq op curl; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "Error: ${cmd} not found."
    return 1
  fi
done

echo "Fetching Linear ticket ${ticket_id}..."

# Fetch Linear API token from 1Password
local linear_token
linear_token=$(op read "op://Chau Personal/linear pat/credential") || {
  echo "Error: Failed to read Linear API token from 1Password"
  return 1
}

# Fetch ticket data from Linear GraphQL API
local gql_query api_tmpfile
gql_query=$(jq -n --arg tid "$ticket_id" '{
  query: "{ issue(id: \"\($tid)\") { title description comments { nodes { body createdAt user { name } } } } }"
}')

api_tmpfile=$(mktemp)

curl -s https://api.linear.app/graphql \
  -H "Authorization: $linear_token" \
  -H "Content-Type: application/json" \
  -d "$gql_query" -o "$api_tmpfile" || {
  echo "Error: Failed to fetch from Linear API"
  rm -f "$api_tmpfile"
  return 1
}

# Check for API errors
if jq -e '.errors' "$api_tmpfile" &>/dev/null; then
  echo "Error: Linear API returned errors:"
  jq '.errors' "$api_tmpfile"
  rm -f "$api_tmpfile"
  return 1
fi

# Extract raw fields
local raw_title raw_description raw_comments
raw_title=$(jq -r '.data.issue.title // empty' "$api_tmpfile")
raw_description=$(jq -r '.data.issue.description // "No description"' "$api_tmpfile")
raw_comments=$(jq -r '.data.issue.comments.nodes[] | "[\(.user.name) - \(.createdAt)]: \(.body)"' "$api_tmpfile" 2>/dev/null)

if [[ -z "$raw_title" ]]; then
  echo "Error: Could not find ticket ${ticket_id}"
  echo "API response:"
  jq . "$api_tmpfile"
  rm -f "$api_tmpfile"
  return 1
fi

rm -f "$api_tmpfile"

# Summarize with OpenCode (non-interactive)
local opencode_prompt="Given this Linear ticket, return ONLY a JSON object (no markdown fences, no explanation):

Title: ${raw_title}

Description:
${raw_description}

Comments:
${raw_comments:-No comments}

Return:
{
  \"title\": \"the ticket title\",
  \"description_summary\": \"1-2 sentence summary of the description\",
  \"comments_summary\": \"1-2 sentence summary of key comments, or 'No comments' if none\",
  \"suggested_slug\": \"concise-kebab-case-slug-from-title (max 5 words)\"
}"

local opencode_response
opencode_response=$(opencode run --model openai/gpt-5.4-mini "$opencode_prompt" 2>/dev/null)

# Extract JSON from response (handle markdown fences, surrounding text, etc.)
local raw_response="$opencode_response"
opencode_response=$(echo "$opencode_response" | sed 's/^```json//; s/^```//')
opencode_response=$(echo "$opencode_response" | awk '/\{/{found=1} found{print} /\}/{if(found) exit}')

# Parse JSON
local title description_summary comments_summary slug
title=$(echo "$opencode_response" | jq -r '.title // empty' 2>/dev/null)
description_summary=$(echo "$opencode_response" | jq -r '.description_summary // empty' 2>/dev/null)
comments_summary=$(echo "$opencode_response" | jq -r '.comments_summary // empty' 2>/dev/null)
slug=$(echo "$opencode_response" | jq -r '.suggested_slug // empty' 2>/dev/null)

if [[ -z "$title" || -z "$slug" ]]; then
  echo "Error: Failed to parse ticket information"
  echo "Raw response from OpenCode:"
  echo "$raw_response"
  return 1
fi

local dir_name="${ticket_id}-${slug}"
local branch_name="ct/${ticket_id}-${slug}"

echo ""
echo "Ticket: ${title}"
echo "Directory: ${dir_name}"
echo "Branch: ${branch_name}"
echo ""

# Create worktree
wtadd "$dir_name" "$base_branch" --branch "$branch_name" --tmux none || return 1

# Resolve worktree path
local worktree_base
worktree_base=$(_wt_resolve_base) || return 1
local worktree_path="${worktree_base}/${dir_name}"

# Create context file
mkdir -p "${worktree_path}/tmp"
cat > "${worktree_path}/tmp/${ticket_id}-initial-context.md" <<EOF
# ${ticket_id}: ${title}

## Description
${description_summary}

## Comments
${comments_summary}
EOF

echo ""
echo "Context file created at tmp/${ticket_id}-initial-context.md"

_wt_tmux_session "$dir_name" "$worktree_path" "$tmux_mode"
