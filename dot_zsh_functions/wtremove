# wtremove - Remove a git worktree and its branch
# Usage: wtremove <directory-name>

if [[ $# -ne 1 ]]; then
  echo "Usage: wtremove <directory-name>"
  echo "Example: wtremove my-feature"
  return 1
fi

local worktree_base
worktree_base=$(_wt_resolve_base) || return 1

# Resolve main git root (linked worktree aware)
local git_dir git_common_dir git_root
git_dir=$(git rev-parse --git-dir 2>/dev/null) || {
  echo "Error: Not in a git repository"
  return 1
}
git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null)

local abs_git_dir abs_common_dir
abs_git_dir=$(cd "$git_dir" 2>/dev/null && pwd)
abs_common_dir=$(cd "$git_common_dir" 2>/dev/null && pwd)

if [[ "$abs_git_dir" != "$abs_common_dir" ]]; then
  git_root=$(dirname "$abs_common_dir")
else
  git_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "Error: Cannot determine git root"
    return 1
  }
fi

local directory_name="$1"
local worktree_path="${worktree_base}/${directory_name}"

# Check if worktree exists
if [[ ! -d "$worktree_path" ]]; then
  echo "Error: Worktree directory ${worktree_path} does not exist"
  return 1
fi

echo "Removing worktree: ${worktree_path}"

# Get the branch name associated with this worktree
local branch_name
branch_name=$(git -C "$git_root" worktree list --porcelain | awk -v path="$(realpath "$worktree_path")" '
  $1 == "worktree" && $2 == path { getline; if ($1 == "branch") print substr($0, 8) }')

if [[ -z "$branch_name" ]]; then
  echo "Warning: Could not determine branch name for worktree"
else
  echo "Associated branch: ${branch_name}"
fi

# Remove the worktree with git
echo "Removing git worktree..."
git -C "$git_root" worktree remove "$worktree_path"

# If we got the branch name, try to remove the local branch
if [[ -n "$branch_name" ]]; then
  echo "Removing local branch: ${branch_name}"
  git -C "$git_root" branch -D "$branch_name" 2>/dev/null || echo "Warning: Could not remove branch ${branch_name}"
fi

# Check if worktree directory still exists
if [[ -d "$worktree_path" ]]; then
  echo "Warning: Worktree directory still exists. Force removing..."
  rm -rf "$worktree_path"
  if [[ $? -eq 0 ]]; then
    echo "  ✓ Successfully removed directory"
  else
    echo "  ✗ Failed to remove directory. You may need to close any editors and remove manually."
    return 1
  fi
fi

echo "Worktree ${directory_name} removed successfully"
