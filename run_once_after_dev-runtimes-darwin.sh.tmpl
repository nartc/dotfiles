{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -u -o pipefail

log() {
  printf "==> %s\n" "$1"
}

warn() {
  printf "⚠️  %s\n" "$1" >&2
}

NODE_DEFAULT_VERSION="20.19.0"
NODE_VERSIONS=("20.19.0" "22.14.0" "24.12.0")
PYTHON_VERSION="3.12.12"

if command -v fnm >/dev/null 2>&1; then
  log "Installing Node.js versions with fnm"
  for version in "${NODE_VERSIONS[@]}"; do
    if ! fnm list | grep -q "v${version}"; then
      fnm install "$version" || warn "Failed to install Node.js ${version}"
    fi
  done

  fnm default "$NODE_DEFAULT_VERSION" || warn "Failed to set fnm default ${NODE_DEFAULT_VERSION}"

  if ! fnm exec --using "$NODE_DEFAULT_VERSION" node -v >/dev/null 2>&1; then
    warn "Node.js ${NODE_DEFAULT_VERSION} is not executable via fnm; please run fnm setup manually"
  fi
else
  warn "fnm not found; skipping Node.js setup"
fi

if command -v pyenv >/dev/null 2>&1; then
  log "Installing Python ${PYTHON_VERSION} with pyenv"
  if ! pyenv versions --bare | grep -qx "$PYTHON_VERSION"; then
    pyenv install "$PYTHON_VERSION" || warn "Failed to install Python ${PYTHON_VERSION}"
  fi
  pyenv global "$PYTHON_VERSION" || warn "Failed to set global Python ${PYTHON_VERSION}"
else
  warn "pyenv not found; skipping Python setup"
fi

if command -v bun >/dev/null 2>&1; then
  log "Bun already installed"
else
  log "Installing Bun"
  curl -fsSL https://bun.sh/install | bash || warn "Failed to install Bun"
fi

TMUX_PLUGIN_INSTALLER="$HOME/.config/tmux/plugins/tpm/bin/install_plugins"
if [ -x "$TMUX_PLUGIN_INSTALLER" ]; then
  log "Installing/updating tmux plugins"
  "$TMUX_PLUGIN_INSTALLER" || warn "Failed to install tmux plugins"
else
  warn "TMUX plugin installer missing at ${TMUX_PLUGIN_INSTALLER}; skipping tmux plugins"
fi

log "Development runtime bootstrap complete"
{{ end -}}
