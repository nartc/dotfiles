# Java version switcher function
setjava() {
    local formula=""
    local java_home=""
    local java_bin=""

    command -v brew >/dev/null 2>&1 || {
        echo "setjava requires Homebrew-managed OpenJDK installations"
        return 1
    }

    case $1 in
        17)
            formula="openjdk@17"
            ;;
        21)
            formula="openjdk@21"
            ;;
        23)
            formula="openjdk"
            ;;
        *)
            echo "Usage: setjava [17|21|23]"
            return 1
            ;;
    esac

    java_home="$(brew --prefix "$formula" 2>/dev/null)/libexec/openjdk.jdk/Contents/Home"
    java_bin="$(brew --prefix "$formula" 2>/dev/null)/bin"
    [[ -d "$java_home" && -d "$java_bin" ]] || {
        echo "OpenJDK $1 is not installed"
        return 1
    }

    export JAVA_HOME="$java_home"
    local clean_path="$PATH"
    clean_path="${clean_path//\/opt\/homebrew\/opt\/openjdk@17\/bin:/}"
    clean_path="${clean_path//\/opt\/homebrew\/opt\/openjdk@21\/bin:/}"
    clean_path="${clean_path//\/opt\/homebrew\/opt\/openjdk\/bin:/}"
    export PATH="$java_bin:$clean_path"
    echo "Switched to Java $1:"
    java -version
}


